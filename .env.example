# ============================================================
#  AI University FAQ Assistant — Environment Variables
#  Copy this file to .env and fill in the values
# ============================================================

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_DB=faq_db
POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME_strong_password_123

# ── JWT (shared across auth-service and faq-service) ─────────
JWT_SECRET_KEY=CHANGE_ME_super_secret_jwt_key_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
JWT_REFRESH_EXPIRATION_DAYS=7

# ── Internal Service Communication ───────────────────────────
INTERNAL_API_KEY=CHANGE_ME_internal_api_key
SERVICE_SECRET=CHANGE_ME_service_secret

# ── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_USER=rmq_admin
RABBITMQ_PASSWORD=CHANGE_ME_rmq_password

# ── OAuth (optional) ─────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── CORS ─────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Team Member 5 — AI Configuration ────────────────────────
# Provider: "openrouter" | "ollama" | "mock"
AI_PROVIDER=mock
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-3.5-turbo
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── Team Member 5 — File Encryption ─────────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FILE_ENCRYPTION_KEY=
UPLOAD_DIR=/app/secure_uploads
MAX_FILE_SIZE_MB=10

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
